{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sp.interpretation_artifact.v2.1.schema.json",
  "title": "Signal & Prism — Interpretation Artifact (v2.1)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "canon", "domain_pack", "prism", "event", "declared", "domain", "prism_output", "understanding", "posture", "integrity"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sp.interpretation_artifact.v2.1"
    },

    "canon": { "$ref": "#/$defs/versioned_ref" },
    "domain_pack": { "$ref": "#/$defs/versioned_ref" },
    "prism": { "$ref": "#/$defs/versioned_ref" },

    "event": {
      "type": "object",
      "description": "Raw boundary event being interpreted (e.g., PR metadata, tool-call proposal, diff pointers).",
      "additionalProperties": true
    },

    "declared": {
      "type": "object",
      "description": "Declared intent/authority assertions provided by the actor/agent/developer.",
      "additionalProperties": true
    },

    "domain": {
      "type": "object",
      "description": "Domain-specific interpretation output (domain pack evaluation results).",
      "additionalProperties": true
    },

    "prism_output": {
      "type": "object",
      "description": "Prism runtime output and/or gate evaluation details.",
      "additionalProperties": true
    },

    "understanding": {
      "type": "object",
      "description": "Structured narrative explanation intended for reviewers (human or automated).",
      "additionalProperties": true
    },

    "posture": {
      "type": "object",
      "description": "Runtime posture and enforcement outcome metadata.",
      "additionalProperties": true,
      "required": ["worldview_posture", "gate_result"],
      "properties": {
        "worldview_posture": {
          "type": "string",
          "description": "Interpretive posture of the worldview/runtime.",
          "enum": ["advisory", "assertive", "controlled_execution"]
        },
        "gate_result": {
          "type": "string",
          "description": "Deterministic gate outcome for this boundary event.",
          "enum": ["allow", "limit", "deny", "warn", "review_required"]
        },
        "notes": {
          "type": "string"
        }
      }
    },

    "integrity": {
      "type": "object",
      "description": "Tamper-evident signature binding envelope (Authority Contract v1.1).",
      "additionalProperties": true,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "artifact_hash",
        "intent_hash",
        "diff_hash",
        "signature",
        "signing_key_id",
        "ci_run_id",
        "timestamp"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "sp.canonicalization.v1"
        },
        "hash_algorithm": {
          "type": "string",
          "description": "Hash algorithm used to compute hashes in this integrity envelope.",
          "enum": ["sha256"]
        },
        "artifact_hash": {
          "type": "string",
          "description": "Hex digest of H(CANON_ARTIFACT(artifact_without_integrity)).",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "intent_hash": {
          "type": "string",
          "description": "Hex digest of H(CANON_INTENT(INTENT.json)).",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "diff_hash": {
          "type": "string",
          "description": "Hex digest of H(CANON_DIFF(diff_text)).",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "description": "Detached signature over the canonical artifact bytes (excluding integrity). Encoding is implementation-defined (e.g., base64).",
          "minLength": 16
        },
        "signature_format": {
          "type": "string",
          "description": "Optional signature encoding/type indicator.",
          "enum": ["gpg-detached-base64", "gpg-detached-ascii-armored", "raw-base64", "unknown"]
        },
        "signing_key_id": {
          "type": "string",
          "description": "Key fingerprint or stable identifier for the signing key used.",
          "minLength": 8
        },
        "ci_run_id": {
          "type": "string",
          "description": "CI run identifier (e.g., GitHub Actions run id).",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 timestamp of signing.",
          "format": "date-time"
        },
        "scope": {
          "type": "object",
          "description": "Optional: declared evaluation scope used to produce diff/intent (useful for verifiers).",
          "additionalProperties": true,
          "properties": {
            "repo": { "type": "string" },
            "base_sha": { "type": "string" },
            "head_sha": { "type": "string" },
            "diff_command": { "type": "string" }
          }
        }
      }
    }
  },

  "$defs": {
    "versioned_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["canon_id", "canon_version", "canon_hash"],
      "properties": {
        "canon_id": { "type": "string", "minLength": 1 },
        "canon_version": { "type": "string", "minLength": 1 },
        "canon_hash": {
          "type": "string",
          "description": "Hash of the referenced object (format implementation-defined; hex strongly recommended).",
          "minLength": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "canon_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
            "required": ["canon_hash"]
          },
          "then": {}
        }
      ]
    }
  }
}
