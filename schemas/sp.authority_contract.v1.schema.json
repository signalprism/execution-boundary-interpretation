{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signalprism.dev/schemas/sp.authority_contract.v1.schema.json",
  "title": "Signal & Prism — Authority Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "contract_version",
    "purpose",
    "surface_scope",
    "escalation",
    "constraints"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sp.authority_contract.v1"
    },

    "contract_id": {
      "type": "string",
      "minLength": 1
    },

    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "bind_to_change"],
      "properties": {
        "statement": {
          "type": "string"
        },
        "bind_to_change": {
          "type": "boolean"
        }
      }
    },

    "surface_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "allowed_mutation_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
      }
    },

    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical"]
        },
        "allow_escalation": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "domain_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_pack_id", "domain_pack_version"],
      "properties": {
        "domain_pack_id": {
          "type": "string"
        },
        "domain_pack_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "worldview_ref": {
          "type": "string"
        }
      }
    },

    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_deletions",
        "allow_renames",
        "allow_moves"
      ],
      "properties": {
        "max_files": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "allow_deletions": {
          "type": "boolean"
        },
        "allow_renames": {
          "type": "boolean"
        },
        "allow_moves": {
          "type": "boolean"
        }
      }
    },

    "declared_by": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "enum": ["human", "agent"]
        },
        "agent": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
