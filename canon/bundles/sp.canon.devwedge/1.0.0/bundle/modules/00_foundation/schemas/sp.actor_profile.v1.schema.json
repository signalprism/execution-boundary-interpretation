{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sp.actor_profile.v1.schema.json",
  "title": "Signal & Prism Actor Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "actor_id",
    "actor_type",
    "identity_confidence",
    "max_authority"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sp.actor_profile.v1"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "ci",
        "automation",
        "ai_agent",
        "external"
      ]
    },
    "identity_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "max_authority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "allowed_intents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
