{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sp.action_decision_artifact.v1.schema.json",
  "title": "Signal & Prism Action Decision Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "actor",
    "source_signal",
    "declared_intent",
    "requested_action",
    "decision",
    "posture",
    "integrity"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sp.action_decision_artifact.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "ci",
            "automation",
            "ai_agent",
            "external"
          ]
        }
      }
    },
    "source_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "trust_tier"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "trust_tier": {
          "type": "string",
          "enum": [
            "trusted",
            "constrained",
            "untrusted"
          ]
        },
        "content_ref": {
          "type": "string"
        }
      }
    },
    "declared_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_type",
        "intent_version"
      ],
      "properties": {
        "intent_type": {
          "type": "string",
          "minLength": 1
        },
        "intent_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type"
      ],
      "properties": {
        "action_type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "required_authority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "reason_codes",
        "summary"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "escalate",
            "advisory"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "advisory",
            "enforce"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "artifact_hash"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "minLength": 1
        },
        "hash_algorithm": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hash": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}
