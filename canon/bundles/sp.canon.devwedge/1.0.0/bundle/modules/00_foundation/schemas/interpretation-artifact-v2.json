{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal & Prism Interpretation Artifact v2 (Dev Wedge)",
  "type": "object",
  "required": ["schema", "canon", "domain_pack", "prism", "event", "declared", "domain", "prism_output", "understanding", "posture"],
  "properties": {
    "schema": { "type": "string", "const": "sp.interpretation_artifact.v2" },
    "canon": {
      "type": "object",
      "required": ["canon_id", "canon_version", "canon_hash"],
      "properties": {
        "canon_id": { "type": "string" },
        "canon_version": { "type": "string" },
        "canon_hash": { "type": "string" }
      }
    },
    "domain_pack": {
      "type": "object",
      "required": ["domain_pack_id", "domain_pack_version"],
      "properties": {
        "domain_pack_id": { "type": "string" },
        "domain_pack_version": { "type": "string" }
      }
    },
    "prism": {
      "type": "object",
      "required": ["prism_id", "prism_version"],
      "properties": {
        "prism_id": { "type": "string" },
        "prism_version": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "required": ["class", "surface", "payload"],
      "properties": {
        "class": { "type": "string" },
        "surface": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "declared": {
      "type": "object",
      "required": ["intent", "authority"],
      "properties": {
        "intent": { "type": "string" },
        "authority": { "type": "string" }
      }
    },
    "domain": {
      "type": "object",
      "required": ["semantic_interpretation", "expectation_evaluation", "interpretive_signals", "narrative_fragments"],
      "properties": {
        "semantic_interpretation": { "type": "object" },
        "expectation_evaluation": { "type": "object" },
        "interpretive_signals": { "type": "object" },
        "narrative_fragments": { "type": "object" }
      }
    },
    "prism_output": {
      "type": "object",
      "required": ["significance_assessment", "rationale", "sensitivity_indicators"],
      "properties": {
        "significance_assessment": { "type": "object" },
        "rationale": { "type": "object" },
        "sensitivity_indicators": { "type": "object" }
      }
    },
    "understanding": {
      "type": "object",
      "required": ["summary", "fragments"],
      "properties": {
        "summary": { "type": "string" },
        "fragments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "posture": {
      "type": "object",
      "required": ["worldview_posture", "gate_result"],
      "properties": {
        "worldview_posture": { "type": "string", "enum": ["advisory"] },
        "gate_result": { "type": "string", "enum": ["pass", "fail"] },
        "notes": { "type": "string" }
      }
    }
  }
}
