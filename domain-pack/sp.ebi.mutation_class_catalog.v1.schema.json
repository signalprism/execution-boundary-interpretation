{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signalprism.dev/schemas/sp.ebi.mutation_class_catalog.v1.schema.json",
  "title": "Signal & Prism — EBI Mutation Class Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "catalog_version", "classes"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sp.ebi.mutation_class_catalog.v1"
    },
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/mutationClass" }
    }
  },
  "definitions": {
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "authority": { "type": "string", "enum": ["none", "low", "medium", "high", "critical"] },

    "mutationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_class_id",
        "class_version",
        "title",
        "description",
        "severity_default",
        "matchers"
      ],
      "properties": {
        "mutation_class_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
        },
        "class_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity_default": { "$ref": "#/definitions/severity" },
        "implied_authority_default": { "$ref": "#/definitions/authority" },

        "policy_tags": { "type": "array", "items": { "type": "string" } },

        "matchers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/matcher" }
        },
        "extractors": {
          "type": "array",
          "items": { "$ref": "#/definitions/extractor" }
        },
        "derivation": { "$ref": "#/definitions/derivation" },

        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exclude_paths": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "matcher_id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "path_glob",
            "file_extension",
            "content_regex",
            "json_key_delta",
            "yaml_key_delta",
            "lockfile_delta",
            "executable_bit_change",
            "binary_file_change",
            "high_entropy_string"
          ]
        },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "pattern": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "min_length": { "type": "integer", "minimum": 1 },
        "entropy_threshold": { "type": "number", "minimum": 0 },
        "emit": { "type": "string" }
      }
    },

    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "extractor_id": { "type": "string" },
        "type": { "type": "string", "enum": ["json_key_delta", "yaml_key_delta", "content_regex"] },
        "paths": { "type": "array", "items": { "type": "string" } },
        "pattern": { "type": "string" },
        "emit": { "type": "string", "minLength": 1 }
      }
    },

    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inputs"],
      "properties": {
        "type": { "type": "string", "enum": ["permission_lattice_compare", "dep_delta_rules"] },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "escalation_if_any": { "type": "array", "items": { "type": "string" } },
        "operations": {
          "type": "array",
          "items": { "type": "string", "enum": ["add", "remove", "upgrade", "downgrade", "modify"] }
        }
      }
    }
  }
}
